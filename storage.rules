rules_version = '2';

// Deployed via `firebase deploy --only storage`, or paste into
// Console -> Storage -> Rules -> Publish.
service firebase.storage {
  match /b/{bucket}/o {

    // Blog post images, uploaded from the admin dashboard. Publicly
    // readable (they're embedded in public post pages); only the admin
    // account can upload/replace/delete.
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'work.jerrywu@gmail.com';
    }

    // Everything else stays closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
