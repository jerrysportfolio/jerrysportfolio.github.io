rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste this into Firebase Console -> Firestore Database -> Rules -> Publish)
//
// stats/gallery holds two counters this site's client-side JS reads and
// increments directly (no auth — this is a public personal-site counter,
// not sensitive data). The rules below are intentionally narrow:
// - anyone can READ the counters, so the page can display them.
// - a write may only touch the `views` / `downloads` fields, only as an
//   increment relative to the current value (not an arbitrary overwrite),
//   and only within [0, 1] per write — the sessionStorage guard in v2.js
//   already keeps this to ~1 write per visitor per session, but the rule
//   is what actually stops someone from scripting a million writes from
//   the browser console, since anyone can read this file or open devtools.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stats/gallery {
      allow read: if true;
      allow create: if isValidStatsWrite(request.resource.data, {views: 0, downloads: 0});
      allow update: if isValidStatsWrite(request.resource.data, resource.data);
    }
    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isValidStatsWrite(newData, oldData) {
  return newData.keys().hasOnly(['views', 'downloads'])
    && newData.views is int && newData.downloads is int
    && newData.views >= int(oldData.views) && newData.views <= int(oldData.views) + 1
    && newData.downloads >= int(oldData.downloads) && newData.downloads <= int(oldData.downloads) + 1;
}
