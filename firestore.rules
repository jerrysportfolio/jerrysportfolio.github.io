rules_version = '2';

// Deployed via `firebase deploy --only firestore:rules`, or paste into
// Console -> Firestore Database -> Rules -> Publish.
//
// Admin identity is checked by email on the Firebase Auth token, not by
// anything client-side — the admin dashboard's login screen is just UX,
// this is the actual security boundary. Update ADMIN_EMAIL below (and
// redeploy) if the dashboard login email ever changes.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'work.jerrywu@gmail.com';
    }

    // Blog posts: public can read only published posts; the admin dashboard
    // (signed in) can read everything, including drafts, and is the only
    // writer.
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Gallery + blog view/download counters: low-stakes, publicly-incremented
    // stats (same trust level as the working gallery counters already in
    // prod) — anyone can bump them, but only with a plain numeric increment,
    // never arbitrary fields.
    match /stats/{statId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['views', 'downloads'])
        && request.resource.data.keys().size() > 0
        && (!('views' in request.resource.data) || request.resource.data.views is int)
        && (!('downloads' in request.resource.data) || request.resource.data.downloads is int);
    }

    match /blogStats/{slug} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views is int;
    }

    // Site-wide page-view events, one document per visit, powering the
    // dashboard's time-windowed traffic charts. Anyone can log a view of a
    // real page they're actually on; only the admin can read them back —
    // visitors' browsing shouldn't be queryable by other visitors. Events are
    // immutable facts once logged, except for a one-time durationSeconds.
    match /pageViews/{eventId} {
      allow read: if isAdmin();
      // Optional visitor-profile fields (country / deviceType / os) are
      // written on create alongside the original ones; each is type- and
      // size-checked so the collection can't be used to store arbitrary data.
      allow create: if request.resource.data.keys().hasOnly(['page', 'slug', 'referrerHost', 'date', 'createdAt', 'country', 'deviceType', 'os'])
        && request.resource.data.page is string
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && (!('country' in request.resource.data)
            || (request.resource.data.country is string && request.resource.data.country.size() <= 100))
        && (!('deviceType' in request.resource.data)
            || request.resource.data.deviceType in ['desktop', 'mobile', 'tablet'])
        && (!('os' in request.resource.data)
            || (request.resource.data.os is string && request.resource.data.os.size() <= 30));
      // The one permitted update: attaching time-on-page (whole seconds) to an
      // event, once, when the visitor leaves the page. Nothing else can change.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durationSeconds'])
        && !('durationSeconds' in resource.data)
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.durationSeconds <= 86400;
      allow delete: if false;
    }

    // Everything else stays closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
